# Database Configuration
# Replace with your own local PostgreSQL credentials
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/petrolq_nwis

# Frontend Origin for CORS (default allows all in dev)
FRONTEND_URL=*

# ==============================================================================
# AI & LLM Model Provider Configuration (SIH 2026 Mandate)
# Choose between Google Gemini, Anthropic Claude, OpenAI, or local Ollama.
# Mode options: 'auto' (detects by available key), 'gemini', 'claude', 'openai', 'ollama'
# ==============================================================================
LLM_PROVIDER=auto

# Option 1: Google Gemini (Get free API key at https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL_NAME=gemini-1.5-flash

# Option 2: Anthropic Claude (Get API key at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_NAME=claude-3-5-haiku-20241022

# Option 3: OpenAI (Get API key at https://platform.openai.com)
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL_NAME=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 4: Local Ollama (Free, Private & 100% Offline — run 'ollama run llama3')
OLLAMA_ENDPOINT=http://localhost:11434/v1
OLLAMA_MODEL_NAME=llama3

# Legacy / Universal Fallback Key (Backward compatible)
LLM_API_KEY=your-api-key-here
LLM_ENDPOINT=http://localhost:11434/v1
LLM_MODEL_NAME=llama3
